pipelineConfig:
  language: PySpark

jobConfig:
  runner: Local
  jobId: rate-stream-to-delta
  useSparkConnect: false
  checkpointRoot: file:///tmp/spark-pipeline-builder/rate-stream-to-delta/checkpoints
  defaultTriggerType: processingTime
  defaultTriggerInterval: 5 seconds

runtimeVariables:
  - key: JOB_ID
    value: rate-stream-to-delta
  - key: RATE_ROWS_PER_SECOND
    value: "10"
  - key: DELTA_TABLE_PATH
    value: file:///tmp/spark-pipeline-builder/rate-stream-to-delta/delta-events
  - key: CHECKPOINT_ROOT
    value: file:///tmp/spark-pipeline-builder/rate-stream-to-delta/checkpoints

nodes:
  - id: src_rate
    type: pipeline
    position:
      x: 80
      y: 160
    data:
      label: Synthetic Rate Stream
      type: SOURCE
      iconName: Zap
      spark_transform: RateSource
      supportedReadModes:
        - streaming
      defaultReadMode: streaming
      properties:
        readMode: streaming
        rateFormat: rate
        rowsPerSecond: 10
        rampUpTime: 2s
        numPartitions: 2

  - id: step_enrich_columns
    type: pipeline
    position:
      x: 380
      y: 160
    data:
      label: Derive Event Columns
      type: STEP
      iconName: Wrench
      spark_transform: WithColumns
      properties:
        columns:
          - name: event_key
            expression: concat('evt-', cast(pmod(value, 50) as string))
            castType: STRING
          - name: device_bucket
            expression: pmod(value, 4)
            castType: INT
          - name: event_date
            expression: to_date(timestamp)
            castType: DATE

  - id: step_watermark
    type: pipeline
    position:
      x: 680
      y: 160
    data:
      label: Event-Time Watermark
      type: STEP
      iconName: Clock
      spark_transform: Watermark
      properties:
        eventTimeColumn: timestamp
        delayThreshold: 1 minute
        sourceTimestampType: timestamp

  - id: step_deduplicate
    type: pipeline
    position:
      x: 980
      y: 160
    data:
      label: Watermark Key Deduplicate
      type: STEP
      iconName: Key
      spark_transform: Deduplicate
      properties:
        strategy: within_watermark
        subsetColumns:
          - event_key

  - id: sink_delta
    type: pipeline
    position:
      x: 1280
      y: 160
    data:
      label: Local Delta Lake Sink
      type: SINK
      iconName: Layers
      spark_transform: DeltaSink
      streamingSinkMode: native
      properties:
        targetMode: path
        path: file:///tmp/spark-pipeline-builder/rate-stream-to-delta/delta-events
        writeMode: append
        partitionBy: event_date
        mergeSchema: true
        outputMode: append
        triggerType: processingTime
        triggerInterval: 5 seconds
        checkpointLocation: file:///tmp/spark-pipeline-builder/rate-stream-to-delta/checkpoints/sink_delta

edges:
  - id: e_rate_to_enrich
    source: src_rate
    target: step_enrich_columns
  - id: e_enrich_to_watermark
    source: step_enrich_columns
    sourceHandle: valid
    target: step_watermark
  - id: e_watermark_to_dedup
    source: step_watermark
    sourceHandle: valid
    target: step_deduplicate
  - id: e_dedup_to_delta
    source: step_deduplicate
    sourceHandle: valid
    target: sink_delta
